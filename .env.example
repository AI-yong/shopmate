# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#
#     cp .env.example .env
#
# .env 는 .gitignore 에 있어 커밋되지 않습니다. 실제 키·비밀번호는 .env 에만 적습니다.

# --- 모델 서버 (OpenAI 호환 /v1/chat/completions) ---
LOCAL_API_BASE_URL=http://127.0.0.1:4000/v1
LOCAL_API_KEY=
MODEL_NAME=gemma-4-31b
# 사용자 사진의 아이템·영역 분석 모델. 비우면 MODEL_NAME 과 같은 모델을 쓴다.
SHOPPING_VLM_MODEL=

# --- 모델 호출 옵션 ---
REQUEST_TIMEOUT=120
TEMPERATURE=0.2
MAX_TOKENS=1024
# 한 요청에서 Tool 을 연달아 부를 수 있는 최대 횟수 (무한 루프 방지)
MAX_TOOL_ITERATIONS=12

# 요청 본문에 그대로 합쳐지는 추가 파라미터(JSON). thinking 끄기 등 서버별 옵션에 쓴다.
# 예: Gemma 4 챗 템플릿 → {"chat_template_kwargs": {"enable_thinking": false}}
EXTRA_BODY=
# 사진 분석 호출에만 쓰는 추가 파라미터. 비우면 EXTRA_BODY 를 쓴다.
SHOPPING_VLM_EXTRA_BODY=

# --- 에이전트 동작 ---
# Tool 결과를 원래 요청과 대조하고, 안전한 누락만 한 번 자동 보완한다.
ADAPTIVE_AGENT_MODE=1
MAX_VERIFIER_RETRIES=1
# 확인 버튼 직전 검증(이번 턴에 실패한 Tool 이 있을 때만)
VERIFY_BEFORE_CONFIRM=1
# 승인 버튼 유효 시간(초)
PENDING_TTL_SECONDS=300
# 사용자가 명시적으로 기억을 요청한 쇼핑 선호를 저장한다.
USER_MEMORY_ENABLED=1

# --- 텍스트 검색 ---
EMBED_MODEL_NAME=nlpai-lab/KURE-v1
# 의미 검색 코사인 유사도 하한
SEMANTIC_MIN_SCORE=0.40

# --- 사진 검색 ---
# qwen(기본): Qwen3-VL 임베딩 서비스 / rrf: SigLIP + KURE 순위 결합. qwen 이 실패하면 rrf 로 폴백한다.
MULTIMODAL_BACKEND=qwen
QWEN3_VL_RECIPE=image_search_text
QWEN3_VL_SERVICE_URL=http://127.0.0.1:8092
QWEN3_VL_SERVICE_TIMEOUT_SECONDS=30
# 한국어 텍스트-이미지 공동 검색용 다국어 SigLIP 2 (검증한 commit 고정)
SIGLIP_MODEL_NAME=google/siglip2-base-patch16-384
SIGLIP_MODEL_REVISION=f775b65a79762255128c981547af89addcfe0f88

# --- 데이터베이스 ---
# 업무 데이터(shop)와 세션 상태(session)를 다른 DB 에 둔다.
SHOP_DSN=postgresql://postgres:changeme@127.0.0.1:5432/shop
SESSION_DSN=postgresql://postgres:changeme@127.0.0.1:5432/session
# 웹 서버 전용 최소 권한 계정 (deploy/roles.sql · grants_*.sql). 비우면 위 계정을 쓴다.
APP_SHOP_DSN=postgresql://app_shop:changeme@127.0.0.1:5432/shop
APP_SESSION_DSN=postgresql://app_session:changeme@127.0.0.1:5432/session
# 세션 쿠키 수명(초). HTTPS 로 서비스하면 SESSION_COOKIE_SECURE=1
SESSION_MAX_AGE_SECONDS=2592000
SESSION_COOKIE_SECURE=0
# 대화 문맥을 마지막 사용 뒤 몇 시간 보관하는가
SESSION_STATE_IDLE_HOURS=24

# --- 객체 저장소 (MinIO) ---
MINIO_ENDPOINT=127.0.0.1:9000
# 로컬 개발 기본값. 외부에 노출되는 환경에서는 반드시 별도 키로 바꾼다.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fashion-catalog
MINIO_SECURE=0
# 사용자 질의 이미지는 정규화 후 임시 저장되며 기본 1시간 뒤 만료된다.
IMAGE_QUERY_MAX_BYTES=8388608
IMAGE_QUERY_MAX_PIXELS=25000000
IMAGE_QUERY_TTL_SECONDS=3600
